{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "redirects": [
    { "source": "/demo/cafecenter", "destination": "/demo", "permanent": false },
    { "source": "/demo/cafecenter/(.*)", "destination": "/demo", "permanent": false },
    { "source": "/demo/client", "destination": "/demo/pc/?app=gc", "permanent": false },
    { "source": "/demo/client/(.*)", "destination": "/demo/pc/?app=gc", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/panel",
      "destination": "/demo/panel/index.html"
    },
    {
      "source": "/demo/panel/(.*)",
      "destination": "/demo/panel/index.html"
    },
    {
      "source": "/demo/client",
      "destination": "/demo/client/index.html"
    },
    {
      "source": "/demo/cafecenter",
      "destination": "/demo/cafecenter/index.html"
    },
    {
      "source": "/demo/cafecenter/(.*)",
      "destination": "/demo/cafecenter/index.html"
    },
    {
      "source": "/demo/pc",
      "destination": "/demo/pc/index.html"
    },
    {
      "source": "/demo/pc/(.*)",
      "destination": "/demo/pc/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
